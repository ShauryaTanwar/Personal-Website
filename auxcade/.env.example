# PUBLIC application identifier. A client secret is never needed.
VITE_SPOTIFY_CLIENT_ID=
# Must exactly match the Spotify developer dashboard, including trailing slash.
# Local: http://127.0.0.1:4173/
# Pages: http://shauryatanwar.github.io/Personal-Website/auxcade/
VITE_SPOTIFY_REDIRECT_URI=
# Optional. Set to true to request Premium browser-playback permissions.
# Leave false for the simplest top-artists/tracks connection flow.
VITE_SPOTIFY_PLAYBACK=false
